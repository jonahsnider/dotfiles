export MISE_IGNORED_CONFIG_PATHS="$HOME/programming/dotfiles/private_dot_config/mise"

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv bash)"
{{ end -}}

# mise
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"

{{ if eq .chezmoi.os "darwin" -}}
# Rex
if ! type -P rex >/dev/null; then
    export PATH="$PATH:$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS"
fi
{{ end -}}

# direnv
eval "$(direnv hook bash)"

# Vite+ bin (https://viteplus.dev)
. "$HOME/.config/vite-plus/env"
