{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu
umask 077
mkdir -p "$HOME/.ssh"
# The SSH server is emulated locally; Sprites credentials authenticate remote access.
if [ ! -f "$HOME/.ssh/sprite-proxy" ]; then
    ssh-keygen -q -t ed25519 -N '' -C 'Local Sprites SSH proxy' -f "$HOME/.ssh/sprite-proxy"
fi
{{ end -}}
