{{ if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (lstat "/run/systemd/system")) -}}
#!/usr/bin/env fish

# https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#run-a-script-when-the-contents-of-another-file-changes

# pitchfork config hash: {{ include "private_dot_config/pitchfork/config.toml.tmpl" | sha256sum }}
# Only needed once per system, but it's idempotent
{{ if eq .chezmoi.os "darwin" -}}
pitchfork boot enable
# launchd's default PATH omits Homebrew, so daemons couldn't find tools like docker
plutil -replace EnvironmentVariables -json '{"PATH":"/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin"}' ~/Library/LaunchAgents/pitchfork.plist
# Reload the agent so launchd picks up the edited plist
launchctl bootout gui/(id -u)/pitchfork 2>/dev/null
# bootout returns before the supervisor finishes shutting down
while launchctl print gui/(id -u)/pitchfork &>/dev/null
    sleep 0.5
end
launchctl bootstrap gui/(id -u) ~/Library/LaunchAgents/pitchfork.plist
pitchfork supervisor start
pitchfork start global/sprite-rex; or exit $status
{{ else -}}
sudo pitchfork boot enable
# Restart the pitchfork supervisor
sudo pitchfork supervisor start --force
{{ end -}}
# Register pitchfork.localhost as localhost:3120 via portless
portless alias pitchfork 3120 --force
{{ end -}}
