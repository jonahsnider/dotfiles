{{ $secrets := includeTemplate "onepassword-secrets.json" . | fromJson -}}
contexts:
- name: argocd.sanity.tools
  server: argocd.sanity.tools
  user: argocd.sanity.tools
current-context: argocd.sanity.tools
prompts-enabled: false
servers:
- grpc-web-root-path: ""
  server: argocd.sanity.tools
users:
{{ if index $secrets "ARGOCD_AUTH_TOKEN" -}}
- auth-token: {{ $secrets.ARGOCD_AUTH_TOKEN | quote }}
  name: argocd.sanity.tools
{{ else -}}
- name: argocd.sanity.tools
{{ end -}}
