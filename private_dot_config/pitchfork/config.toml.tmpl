#:schema https://pitchfork.en.dev/schema.json

[settings.web]
auto_start = true
bind_address = "127.0.0.1"
bind_port = 3120
port_attempts = 1

[settings.general]
mise = true

{{ if eq .chezmoi.os "darwin" -}}
[settings.boot]
# Keep launchd independent of Homebrew's versioned Cellar paths.
executable = "/opt/homebrew/bin/pitchfork"
{{ end -}}
