set modules_dir (dirname (status --current-filename))/modules

# Stage 1 - No dependencies
source $modules_dir/env.fish

# Stage 2 - Depends on env
source $modules_dir/path.fish

{{ if eq .chezmoi.os "darwin" -}}
# macOS tools
fish_add_path -g /Applications
fish_add_path /opt/homebrew/opt/libpq/bin

# Rex
if not command -sq rex
    fish_add_path -g --append "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS"
end
{{ end -}}

fish_add_path --global --prepend "{{ .chezmoi.homeDir }}/programming/sanity/sanity-nix-config/.devenv/bin"
mise activate fish | source

# Stage 3 - Everything else
source $modules_dir/mnemonics.fish
{{ if ne .chezmoi.os "linux" -}}
# 1Password plugins
source ~/.config/op/plugins.sh

{{ end -}}
source $modules_dir/general.fish
source $modules_dir/prompt.fish

{{- if joinPath .chezmoi.homeDir "programming/sanity/mise-config/shell-hooks/loaded.fish" | lstat }}
test -f "{{ .chezmoi.homeDir }}/programming/sanity/mise-config/shell-hooks/loaded.fish"; and source "{{ .chezmoi.homeDir }}/programming/sanity/mise-config/shell-hooks/loaded.fish"
{{- end }}
