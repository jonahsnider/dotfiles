{
  "$schema": "https://raw.githubusercontent.com/sinelaw/fresh/refs/heads/master/crates/fresh-editor/plugins/config-schema.json",
  "theme": "builtin://dracula",
  "check_for_updates": false,
  "macos-option-as-alt": "left",

  "editor": {
    "show_menu_bar": true,
    "menu_bar_mnemonics": false,
    "show_tab_bar": false,
    "show_tilde": false,
    "whitespace_show": false,

    "completion_popup_auto_show": false,
    "enable_inlay_hints": false,

    "restore_previous_session": false,
    "hot_exit": false,

    "status_bar": {
      "left": ["{diagnostics}", "{cursor_count}", "{chord}", "{filename}"],
      "right": ["{cursor}", "{messages}", "{read_only}"]
    }
  },

  "file_explorer": {
    "auto_open_on_last_buffer_close": false
  },

  "terminal": {
    "resume_agents": false
  },
  "keybindings": [
    {
      "key": "Backspace",
      "modifiers": ["alt"],
      "action": "delete_word_backward",
      "when": "normal"
    }
  ],
  "plugins": {
    "devcontainer": { "enabled": false },
    "diagnostics_panel": { "enabled": false },
    "k8s-workspace": { "enabled": false },
    "orchestrator": { "enabled": false },
    "test_i18n": { "enabled": false },
    "theme_editor": { "enabled": false },
    "vi_mode": { "enabled": false },
    "welcome": { "enabled": false }
  }
}
