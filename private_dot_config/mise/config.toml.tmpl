[tools]
age = "latest"
bun = "latest"
fnox = "latest"
gh = "latest"
"github:facebook/infer" = "latest"
"github:railwayapp/railpack" = "latest"
go = "latest"
java = "temurin-25"
node = "26"
pnpm = "12"
python = "3.11"
ruff = "latest"
rust = "latest"
uv = "latest"
yarn = "latest"

[settings]
idiomatic_version_file_enable_tools = ["node", "pnpm", "yarn"]
trusted_config_paths = [
  "~/conductor/workspaces/",
  "{{ .chezmoi.homeDir }}/programming/sanity",
]
env_file = ".env"
auto_update = true

[settings.github]
credential_command = "gh auth token"

[settings.npm]
package_manager = "pnpm"

[env]
SANITY_WORKSPACE = "{{ .chezmoi.homeDir }}/programming/sanity"
SANITY_MISE_BOOTSTRAP_VERSION = "7"
SANITY_NIX_PATH = "{{ .chezmoi.homeDir }}/programming/sanity/sanity-nix-config"
