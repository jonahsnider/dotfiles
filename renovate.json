{
	"extends": ["github>jonahsnider/renovate-config"],
	"npm": {
		"managerFilePatterns": ["/^\\.chezmoitemplates\\/pnpm-global-packages\\.json$/"]
	},
	"packageRules": [
		{
			"description": "Preserve mise version selectors",
			"matchManagers": ["mise"],
			"enabled": false
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^dot_local\\/share\\/gh\\/extensions\\/[^/]+\\/private_manifest\\.yml\\.tmpl$/"],
			"matchStrings": [
				"owner: (?<owner>\\S+)\\s+name: (?<name>\\S+)\\s+host: github\\.com\\s+tag: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "{{{owner}}}/{{{name}}}",
			"datasourceTemplate": "github-releases",
			"depTypeTemplate": "github-cli-extension"
		}
	]
}
