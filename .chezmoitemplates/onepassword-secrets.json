{{- $secrets := dict -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $secrets = include (joinPath .chezmoi.homeDir ".config/op/dotfiles.env") | fromIni -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $command := `export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$HOME/.config/op/service-account-token")"
exec op environment read rajcbrxa4l5ul7igap6fdn6lta` -}}
{{- $secrets = output "sh" "-ec" $command | fromIni -}}
{{- end -}}
{{- pick $secrets "NPM_TOKEN" "GH_TOKEN" "ARGOCD_AUTH_TOKEN" "CIRCLECI_PERSONAL_API_TOKEN" "REX_PACKAGE_TOKEN" | toJson -}}
