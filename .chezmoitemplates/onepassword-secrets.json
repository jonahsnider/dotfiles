{{- $read := `import json, os; keys = ("NPM_TOKEN", "GH_TOKEN", "ARGOCD_AUTH_TOKEN", "CIRCLECI_PERSONAL_API_TOKEN"); secrets = {key: os.environ[key] for key in keys if key in os.environ}; assert secrets.get("NPM_TOKEN"), "NPM_TOKEN is missing or empty in the 1Password Environment"; print(json.dumps(secrets))` -}}
{{- $command := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $command = `unset NPM_TOKEN GH_TOKEN ARGOCD_AUTH_TOKEN CIRCLECI_PERSONAL_API_TOKEN OP_SERVICE_ACCOUNT_TOKEN
exec /opt/homebrew/bin/op run --no-masking --account my.1password.com --environment ytpl4imwegjl52mkroi6mid7x4 -- python3 -c "$1"` -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $command = `unset NPM_TOKEN GH_TOKEN ARGOCD_AUTH_TOKEN CIRCLECI_PERSONAL_API_TOKEN
OP_SERVICE_ACCOUNT_TOKEN=$(cat "$HOME/.config/op/service-account-token")
: "${OP_SERVICE_ACCOUNT_TOKEN:?The service-account token is empty}"
export OP_SERVICE_ACCOUNT_TOKEN
exec op run --no-masking --environment rajcbrxa4l5ul7igap6fdn6lta -- python3 -c "$1"` -}}
{{- end -}}
{{- output "sh" "-ec" $command "chezmoi-1password-environment" $read -}}
